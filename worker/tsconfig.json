{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../src/features/scan/scan-contract.ts",
    "../src/features/ingredients/units.ts",
    "../src/features/categorize/categorize-contract.ts",
    "../src/features/ingredients/taxonomy.ts",
    "../src/features/import/recipe-page.ts"
  ],
  "exclude": [
    "src/__tests__"
  ]
}
