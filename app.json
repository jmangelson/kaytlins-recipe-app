{
  "expo": {
    "name": "Kaytlin's Recipes",
    "slug": "kaytlins-recipe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaytlinsrecipes",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4E2A47",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jmangelson.kaytlinsrecipes",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E2A47",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a recipe or meal.",
          "cameraPermission": "Take a photo of a recipe or meal.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "jmangelsons-team",
    "extra": {
      "googleWebClientId": "579765143755-jovomupnf4r1vlaqhvgfve80cs9jfc0m.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "b034550e-1a25-4d86-b5c9-12cbc88dc632"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b034550e-1a25-4d86-b5c9-12cbc88dc632"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
