rules_version = '2';

// Data model: docs/PLAN.md ("Firestore layout").
//
// - users/{uid}            which household a signed-in user belongs to
// - invites/{code}         maps an invite code to a household id; get-only, so
//                          codes cannot be listed or enumerated
// - households/{hid}       readable/writable only by its members; anyone who
//                          knows the household id (via an invite code) may add
//                          only themselves to memberIds
// - households/{hid}/**    all household data, members only
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in get(householdPath(hid)).data.memberIds;
    }

    function isMemberAfterWrite(hid) {
      return signedIn() && request.auth.uid in getAfter(householdPath(hid)).data.memberIds;
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasOnly(['weekStart', 'showBreakfastLunch'])
        && (!('weekStart' in settings) || (settings.weekStart is int
          && settings.weekStart >= 0 && settings.weekStart <= 6))
        && (!('showBreakfastLunch' in settings) || settings.showBreakfastLunch is bool);
    }

    function validName(name, maxLength) {
      return name is string && name.size() > 0 && name.size() <= maxLength;
    }

    function optionalString(data, key) {
      return !(key in data) || data[key] == null || data[key] is string;
    }

    function validStore(data) {
      return data.keys().hasOnly(['name', 'order', 'hidden', 'sections'])
        && validName(data.name, 60)
        && data.order is int
        && data.hidden is bool
        && data.sections is list && data.sections.size() <= 40;
    }

    function validTag(data) {
      return data.keys().hasOnly(['name', 'order', 'group'])
        && validName(data.name, 40)
        && data.order is int
        && data.group in ['type', 'course', 'meal'];
    }

    function validIngredient(data) {
      return data.keys().hasOnly(['name', 'nameKey', 'aliases', 'aliasKeys', 'category',
          'storePriority', 'areaOverrides', 'defaultUnit'])
        && validName(data.name, 80)
        && validName(data.nameKey, 80)
        && data.aliases is list && data.aliases.size() <= 30
        && data.aliasKeys is list && data.aliasKeys.size() == data.aliases.size()
        && data.category is string && data.category.size() <= 40
        && data.storePriority is list && data.storePriority.size() <= 20
        && data.areaOverrides is map && data.areaOverrides.size() <= 20
        && optionalString(data, 'defaultUnit');
    }

    function validRecipe(data) {
      return data.keys().hasOnly(['name', 'servings', 'tagIds', 'notes', 'hasPhoto',
          'photoIds', 'ingredients', 'createdAt', 'updatedAt'])
        && validName(data.name, 120)
        && data.servings is number && data.servings > 0 && data.servings <= 100
        && data.tagIds is list && data.tagIds.size() <= 20
        && data.notes is string && data.notes.size() <= 5000
        && data.hasPhoto is bool
        && (!('photoIds' in data) || (data.photoIds is list && data.photoIds.size() <= 12))
        && data.ingredients is list && data.ingredients.size() <= 100
        && data.updatedAt == request.time
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function validRecipePhoto(data) {
      // One photo per doc (dish or directions), resized on the phone to about
      // 1400 px (~300 KB of base64); cap under the 1 MiB doc limit.
      return data.keys().hasOnly(['jpegBase64', 'recipeId'])
        && data.jpegBase64 is string && data.jpegBase64.size() <= 900000
        && (!('recipeId' in data) || data.recipeId is string);
    }

    function validMealPlan(data) {
      return data.keys().hasOnly(['name', 'days', 'createdAt', 'updatedAt'])
        && validName(data.name, 60)
        && data.days is list && data.days.size() >= 1 && data.days.size() <= 60
        && data.updatedAt == request.time
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function validCalendarDay(data, dateId) {
      return data.keys().hasOnly(['date', 'meals', 'source', 'updatedAt'])
        && data.date == dateId
        && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.meals is map && data.meals.keys().hasOnly(['breakfast', 'lunch', 'dinner'])
        && (data.source == null || data.source is map)
        && data.updatedAt == request.time;
    }

    function validShoppingList(data) {
      return data.keys().hasOnly(['name', 'status', 'source', 'tripStoreIds', 'lines',
          'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && data.status in ['pantry', 'ready']
        && data.source is map
        && data.tripStoreIds is list && data.tripStoreIds.size() <= 20
        && data.lines is list && data.lines.size() <= 300
        && data.updatedAt == request.time
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Something to buy on the next trips until it's checked off (paper towels).
    function validExtraItem(data) {
      return data.keys().hasOnly(['name', 'ingredientId', 'quantity', 'createdAt', 'updatedAt'])
        && validName(data.name, 80)
        && data.ingredientId is string
        && data.quantity is map
        && data.updatedAt == request.time
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function validHouseholdName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // A user may only point at a household they are a member of (checked
      // after the batch, so create/join and this write can happen together).
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && isMemberAfterWrite(request.resource.data.householdId);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isMemberAfterWrite(request.resource.data.householdId)
        && getAfter(householdPath(request.resource.data.householdId)).data.inviteCode == code;
      allow update: if false;
      // Deleting the household removes its code (by a member, before the household goes).
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'inviteCode', 'createdAt', 'settings'])
        && validHouseholdName(request.resource.data.name)
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.createdAt == request.time
        && validSettings(request.resource.data.settings);

      // Members edit name/settings and record seeding; membership and invite
      // code are fixed.
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'settings', 'seedVersion'])
        && validHouseholdName(request.resource.data.name)
        && validSettings(request.resource.data.settings)
        && (!('seedVersion' in request.resource.data) || request.resource.data.seedVersion is int);

      // Joining: a non-member appends exactly themselves and changes nothing else.
      allow update: if signedIn() && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && request.resource.data.memberIds.size() <= 10;

      // Leaving: a member removes exactly themselves. The last member deletes
      // the household instead, so no household is left without members.
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && request.resource.data.memberIds.size() > 0;

      // Only its last member can delete a household (after its data).
      allow delete: if signedIn() && resource.data.memberIds == [request.auth.uid];

      // Collections with a validated shape. Rules allow a request if ANY
      // matching rule allows it, so the catch-all below excludes these.
      match /stores/{storeId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validStore(request.resource.data);
      }

      match /tags/{tagId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validTag(request.resource.data);
      }

      match /ingredients/{ingredientId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validIngredient(request.resource.data);
      }

      match /recipes/{recipeId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validRecipe(request.resource.data);
      }

      match /recipePhotos/{photoId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validRecipePhoto(request.resource.data);
      }

      match /mealPlans/{planId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validMealPlan(request.resource.data);
      }

      match /calendarDays/{dateId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validCalendarDay(request.resource.data, dateId);
      }

      match /shoppingLists/{listId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validShoppingList(request.resource.data);
      }

      match /extraItems/{itemId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validExtraItem(request.resource.data);
      }

      // Everything else in the household: members only. `{collection}`
      // forces at least one segment: in rules v2 a bare `{document=**}` also
      // matches the household doc itself and would bypass the rules above.
      match /{collection}/{document=**} {
        allow read, write: if isMember(hid)
          && !(collection in ['stores', 'tags', 'ingredients', 'recipes', 'recipePhotos', 'mealPlans',
              'calendarDays', 'shoppingLists', 'extraItems']);
      }
    }
  }
}
